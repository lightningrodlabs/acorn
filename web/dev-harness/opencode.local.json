      "type": "local",
      "command": ["node", "web/dev-harness/acornToolsServer.js"],
      "environment": { "ACORN_WEB_PORT": "8081" },
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",

      },
      "models": {
        "lfm2.5:8b-a1b-q4_K_M": {
          "name": "LFM2.5-8B-A1B (local, Q4_K_M)"
        }
      }
    }
  },
  "model": "ollama/lfm2.5:8b-a1b-q4_K_M"
}

{
    "compilerOptions": {
        "outDir": "dist",
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "types": ["vitest/globals", "node"]
    },
    "include": ["src/**/*", "vitest.config.ts"]
}
